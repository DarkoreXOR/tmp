                                                                                        ; That is a loading and initialization code that also draws the blue screen
                                                                                        ; menu with svn revision number near top right corner of the screen.
                                                                                        include "bootbios.inc"
                                                                                        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
