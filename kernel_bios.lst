                                                                                        MXCSR_PE       =    0x0020
                                                                                        MXCSR_DAZ      =    0x0040
                                                                                        MXCSR_IM       =    0x0080
                                                                                        MXCSR_DM       =    0x0100
                                                                                        MXCSR_ZM       =    0x0200
                                                                                        MXCSR_OM       =    0x0400
