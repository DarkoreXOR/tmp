                                                                                        PAT_TYPE_WB         = 6
                                                                                        PAT_TYPE_UCM        = 7
                                                                                        
                                                                                        PAT_VALUE           = 0x00070106; (UC<<24)|(UCM<<16)|(WC<<8)|WB
                                                                                        
                                                                                        MAX_MEMMAP_BLOCKS   = 32
                                                                                        
