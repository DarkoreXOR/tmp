                                                                                        EVM_MOUSE_FILTER  = 0x80000000  ; see in macros.inc for apps
                                                                                        EVM_CURSOR_FILTER = 0x40000000
                                                                                        
                                                                                        EV_INTR            = 1
                                                                                        
                                                                                        STDIN_FILENO       = 0
