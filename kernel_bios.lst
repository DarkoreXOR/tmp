                                                                                        ;// mike.dld, 2006-29-01 [
                                                                                        
                                                                                        ; macros definition
                                                                                        macro diff16 title,l1,l2
                                                                                        {
                                                                                          local s,d
                                                                                          s = l2-l1
                                                                                          display title,': 0x'
                                                                                          repeat 16
                                                                                            d = 48 + s shr ((16-%) shl 2) and $0F
                                                                                            if d > 57
                                                                                              d = d + 65-57-1
                                                                                            end if
                                                                                            display d
                                                                                          end repeat
                                                                                          display 13,10
                                                                                        }
                                                                                        macro diff10 title,l1,l2
                                                                                         {
                                                                                          local s,d,z,m
                                                                                          s = l2-l1
                                                                                          z = 0
                                                                                          m = 1000000000
                                                                                          display title,': '
                                                                                          repeat 10
                                                                                           d = '0' + s / m
                                                                                           s = s - (s/m)*m
                                                                                           m = m / 10
                                                                                           if d <> '0'
                                                                                            z = 1
                                                                                           end if
                                                                                           if z <> 0
                                                                                            display d
                                                                                           end if
                                                                                          end repeat
                                                                                          display 13,10
                                                                                         }
                                                                                        
