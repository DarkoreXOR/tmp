                                                                                                acpi_rsdp       dd ?
                                                                                                syspath         rb 0x17
                                                                                                devicesdat_data dd ?
                                                                                                devicesdat_size dd ?
                                                                                                bios_hd_cnt     db ?    ; number of BIOS hard disks
                                                                                                bios_hd         rb 0x80 ; BIOS hard disks
                                                                                                memmap_block_cnt dd ?   ; available physical memory map: number of blocks
